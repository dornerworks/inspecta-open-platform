<system>
    <memory_region name="guest_ram0" size="0x4000_0000" page_size="0x200_000" phys_addr="0x2000_0000"/>
    <memory_region name="serial0" size="0x1_000" phys_addr="0xff000000" />
    <memory_region name="ethernet" size="0x1_000" phys_addr="0xff0e0000" />
    <memory_region name="mmc" size="0x1_000" phys_addr="0xff170000" />
    <memory_region name="gic_vcpu" size="0x1_000" phys_addr="0xf9060000" />
    <protection_domain name="VMM0" priority="254" smc="true" cpu="0">
        <program_image path="vmm0.elf" />
        <map mr="guest_ram0" vaddr="0x2000_0000" perms="rw" setvar_vaddr="guest_ram_vaddr" />
        <virtual_machine name="linux0">
            <vcpu id="0" cpu="0" />
            <map mr="guest_ram0" vaddr="0x2000_0000" perms="rwx" />
            <map mr="serial0" vaddr="0xff000000" perms="rw" cached="false" />
            <map mr="ethernet" vaddr="0xff0e0000" perms="rw" cached="false" />
            <map mr="mmc" vaddr="0xff170000" perms="rw" cached="false" />
            <map mr="gic_vcpu" vaddr="0xf9020000" perms="rw" cached="false" />
        </virtual_machine>
        <!-- UART interrupt -->
        <irq irq="53" id="1" />
        <!-- Ethernet interrupt -->
        <irq irq="95" id="2" />
        <!-- MMC interrupt -->
        <irq irq="81" id="3" />
    </protection_domain>

    <memory_region name="guest_ram1" size="0x2000_0000" page_size="0x200_000" phys_addr="0x8_1000_0000"/>
    <memory_region name="serial1" size="0x1_000" phys_addr="0xff010000" />
    <protection_domain name="VMM1" priority="254" smc="true" cpu="1">
        <program_image path="vmm1.elf" />
        <map mr="guest_ram1" vaddr="0x8_1000_0000" perms="rw" setvar_vaddr="guest_ram_vaddr" />
        <virtual_machine name="linux1">
            <vcpu id="0" cpu="1"/>
            <map mr="guest_ram1" vaddr="0x8_1000_0000" perms="rwx" />
            <map mr="serial1" vaddr="0xff010000" perms="rw" cached="false" />
            <!-- <map mr="serial0" vaddr="0xff000000" perms="rw" cached="false" /> -->
            <map mr="gic_vcpu" vaddr="0xf9020000" perms="rw" cached="false" />
        </virtual_machine>
        <!-- UART interrupt -->
        <irq irq="54" id="1" />
    </protection_domain>

    <protection_domain name="core1_app" priority="253" cpu="1" >
        <program_image path="core1.elf" />
    </protection_domain>

    <channel>
        <end pd="VMM0" id="0" />
        <end pd="core1_app"   id="0" />
    </channel>
</system>
